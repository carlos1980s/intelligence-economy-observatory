{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"GPU monthly model panel v2 (generated by import-history)",
  "type":"array",
  "items":{
    "type":"object",
    "required":["provider","segment","gpu","configuration_id","month","log_price","anchor","launch_month","evidence","publication_date","quote_id","anchor_quote_id"],
    "properties":{
      "provider":{"type":"string","minLength":1},
      "segment":{"enum":["hyperscaler","neocloud"]},
      "gpu":{"type":"string","minLength":1},
      "configuration_id":{"type":"string","minLength":1},
      "month":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}$"},
      "log_price":{"type":"number"},"anchor":{"type":"number"},
      "launch_month":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}$"},
      "evidence":{"const":"OBSERVED"},
      "publication_date":{"type":"string","format":"date"},
      "quote_id":{"type":"string"},"anchor_quote_id":{"type":"string"}
    },
    "additionalProperties":false
  }
}
